# ============================================================================
# Angawatch — environment configuration EXAMPLE
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Every value below is optional: if a credential is absent, that integration
# degrades to a CLEARLY-LABELED mock so the demo never hard-fails.
# ============================================================================

# --- Neo4j Aura (the farm-and-finance graph) --------------------------------
# Get free instance at https://neo4j.com/cloud/aura/ . URI uses neo4j+s:// scheme.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# auto | neo4j | memory  (auto = use Neo4j if reachable, else in-memory mock)
GRAPH_BACKEND=auto

# --- OpenRouter (free LLM for agent narration + GraphRAG advisory) -----------
# Free key at https://openrouter.ai/ . CrewAI/litellm string form: openrouter/<model>
OPENROUTER_API_KEY=
# Free models rotate; if this 404s, run scripts/preflight.py and pick another :free model.
OPENROUTER_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
# auto | live | mock  (mock = deterministic templated narration)
LLM_MODE=auto

# --- Twilio WhatsApp sandbox (the crop-saving alert) ------------------------
# https://www.twilio.com/console -> Messaging -> Try it out -> WhatsApp sandbox.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
# E.164, the farmer's phone that has joined the sandbox, e.g. +2547XXXXXXXX
FARMER_PHONE=

# --- Vision (PlantVillage tomato leaf classifier) ---------------------------
# auto | live | mock  (live downloads a HF model; deployed app should use mock)
VISION_MODE=auto
HF_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# --- Masumi network (identity / discovery / escrow payment / audit) ---------
# real | mock  (mock = deterministic, clearly-labeled on-chain simulation)
MASUMI_MODE=mock
NETWORK=Preprod
PAYMENT_SERVICE_URL=
PAYMENT_API_KEY=
AGENT_IDENTIFIER=
SELLER_VKEY=
# Service price. USDM unit shown to users; settle test ADA (lovelace) under the hood.
PAYMENT_AMOUNT=5000000
PAYMENT_UNIT=lovelace
# Optional: a REAL preprod tx hash captured the night before, shown as audit proof.
MASUMI_PRERECORDED_TX=
# Public URL of the deployed MIP-003 service (used for Masumi/Sokosumi registration).
AGENT_API_URL=https://angawatch.example/mip003

# --- Sokosumi (marketplace; +10 bonus) --------------------------------------
SOKOSUMI_API_URL=https://preprod.api.sokosumi.com
SOKOSUMI_API_KEY=

# --- Demo identity ----------------------------------------------------------
DEFAULT_FARMER_ID=Farmer-A
DEFAULT_GREENHOUSE_ID=gh-001
