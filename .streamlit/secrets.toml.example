# Streamlit Community Cloud secrets — EXAMPLE.
# Copy to `.streamlit/secrets.toml` for local dev (gitignored), OR paste these
# keys into the app's "Advanced settings -> Secrets" box on share.streamlit.io.
# Flat keys (they are copied verbatim into the environment). Omit any you lack —
# that capability then runs as a clearly-labeled mock.

# Use neo4j+ssc:// if your network intercepts TLS (routing + cert-tolerant); else neo4j+s://.
# Some Aura instances use the INSTANCE ID as the username and have no 'neo4j' database —
# in that case set NEO4J_USER to the instance id and leave NEO4J_DATABASE blank (home db).
NEO4J_URI = "neo4j+ssc://xxxxxxxx.databases.neo4j.io"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "your-aura-password"
NEO4J_DATABASE = ""

OPENROUTER_API_KEY = "sk-or-xxxxxxxx"
OPENROUTER_MODEL = "openrouter/google/gemma-4-26b-a4b-it:free"

TWILIO_SID = "ACxxxxxxxx"
TWILIO_TOKEN = "xxxxxxxx"
TWILIO_FROM = "whatsapp:+14155238886"
FARMER_PHONE = "+2547XXXXXXXX"

# Keep the deployed app reliable: mock the heavy/optional bits in the cloud.
VISION_MODE = "mock"
MASUMI_MODE = "mock"
